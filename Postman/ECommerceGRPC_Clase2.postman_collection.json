      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"clave\": \"Admin2026!\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 con token\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"rol Admin\", () => pm.expect(j.rol).to.eql(\"Admin\"));",
                  "pm.collectionVariables.set(\"tokenAdmin\", j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Cliente",
          "request": {
            "method": "POST",
