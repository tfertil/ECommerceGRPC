                  "  pm.expect(u).to.have.all.keys('id', 'email', 'nombreCompleto', 'activo', 'creadoEl');",
                  "  pm.expect(pm.response.headers.get('Location')).to.match(new RegExp('/api/v1/usuarios/' + u.id + '$'));",
