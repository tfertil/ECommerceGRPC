    {
      "name": "6 · Tarea 1",
      "description": "Ejecutar después de 0 · Inicio de sesión y en el orden guardado. Cubre las 11 respuestas de la tabla del enunciado. Genera un producto y un usuario por ejecución. Incluye esperas de 31 s para escrituras y 11 s para lecturas. En Runner configure un timeout de scripts mayor que 31000 ms (por ejemplo 60000 ms); con Newman use --timeout-script 60000. Ejecute una iteración, sin otras peticiones simultáneas. La prueba manual de caída de order-grpc del paso 7 se realiza por separado.",
      "item": [
        {
          "name": "01 · Crear producto como Admin (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "productos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{tarea1NombreProducto}}\",\n  \"descripcion\": \"Creado por las pruebas de Tarea 1\",\n  \"precio\": 850.5,\n  \"stock\": 5,\n  \"categoria\": \"Laptops\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Identificadores distintos por ejecución para repetir la colección sin borrar datos.",
                  "const sufijo = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('tarea1NombreProducto', 'Laptop Tarea 1 ' + sufijo);",
                  "pm.collectionVariables.set('tarea1Email', 'tarea1.' + sufijo + '@example.com');",
                  "// Libera la ventana de escrituras consumida por las carpetas anteriores.",
                  "setTimeout(() => {}, 31000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 · 01 · Crear producto como Admin (201)', () => pm.response.to.have.status(201));",
                  "",
                  "pm.test('Producto creado con los datos enviados', () => {",
                  "  const p = pm.response.json();",
                  "  pm.expect(p.id).to.be.a('number').and.to.be.above(0);",
                  "  pm.expect(p.nombre).to.eql(pm.collectionVariables.get('tarea1NombreProducto'));",
                  "  pm.expect(p.descripcion).to.eql('Creado por las pruebas de Tarea 1');",
                  "  pm.expect(p.precio).to.eql(850.50);",
                  "  pm.expect(p.stock).to.eql(5);",
                  "  pm.expect(p.categoria).to.eql('Laptops');",
                  "  pm.expect(p.disponible).to.eql(true);",
                  "  pm.expect(pm.response.headers.get('Location')).to.match(new RegExp('/api/v1/productos/' + p.id + '$'));",
                  "});"
                ]
              }
            }
          ]
        },
